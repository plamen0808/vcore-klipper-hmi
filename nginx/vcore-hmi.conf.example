# Example only. install.sh generates this file with the selected user, port,
# and Moonraker address at /etc/nginx/conf.d/vcore-hmi-standalone.conf.
server {
    listen 8081 default_server;
    server_name _;

    root /home/pi/apps/vcore-hmi;
    index index.html;
    client_max_body_size 0;

    location /websocket {
        proxy_pass http://127.0.0.1:7125/websocket;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 86400;
    }

    location ~ ^/(printer|api|access|machine|server)/ {
        proxy_pass http://127.0.0.1:7125$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Scheme $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
